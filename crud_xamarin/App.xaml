<?xml version="1.0" encoding="utf-8" ?>
<Application xmlns="http://xamarin.com/schemas/2014/forms"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="crud_xamarin.App">
    <Application.Resources>
        <!--estilos globales para controles-->
        <ResourceDictionary>
            <Style TargetType="Label" x:Key="LabelDefaultStyle">
                <Setter Property="TextColor" Value="#232323"/>
                <Setter Property="FontSize" Value="13"/>
            </Style>

            <Style TargetType="Entry" x:Key="EntryDefaultStyle">
                <Setter Property="TextColor" Value="#232323"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="PlaceholderColor" Value="#5f5f5f"/>
            </Style>

            <Style TargetType="Picker" x:Key="PickerDefaultStyle">
                <Setter Property="TextColor" Value="#212121"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="TitleColor" Value="#A9A9A9"/>
            </Style>
        </ResourceDictionary>

        <Color x:Key="DefaultTextColor">#212121</Color>
        <Color x:Key="DefaultPlaceholderColor">#808080</Color>
        <Color x:Key="DefaultPlaceholderColor2">#A9A9A9</Color>
    </Application.Resources>
</Application>